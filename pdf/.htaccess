# Deny execution of scripts in pdf directory (CWE-434 / CVE mitigation)
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc .cgi .pl .sh .bash .py .rb
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc .cgi .pl .sh .bash .py .rb

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|cgi|pl|sh|bash|py|rb|asp|aspx|jsp|jspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
