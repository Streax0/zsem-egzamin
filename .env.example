APP_ENV=local
# Keep false for Apache/PHP requests. Schema comes from full_schema.sql.
APP_RUNTIME_SCHEMA_UPDATES=false
# Values other than local/dev/test enforce a non-root user and a non-empty DB password.
# Weak local credentials are rejected when the database endpoint is not localhost/loopback/socket.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_SOCKET=
MYSQL_DATABASE=inf02_platform
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT=5

# Optional TLS for a remote MySQL/MariaDB server. Relative paths start at the app root.
# Certificate and key must be set together. Server certificate verification is mandatory.
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

# Canonical public URL used in password-reset emails and exam QR links.
APP_BASE_URL=http://localhost/public_html

# Enable only behind a reverse proxy and list every trusted proxy IP/CIDR.
APP_TRUST_PROXY_HEADERS=false
APP_TRUSTED_PROXY_IPS=

# Must be writable by PHP. Empty uses an isolated system-temp directory.
APP_RATE_LIMIT_DIR=

# Required only when cron/cleanup.php is exposed outside CLI.
CRON_SECRET=
