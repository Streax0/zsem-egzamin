APP_ENV=local

MYSQL_HOST=localhost
MYSQL_DATABASE=inf02_platform
MYSQL_USER=root
MYSQL_PASSWORD=

# Canonical public URL used in password-reset emails and exam QR links.
APP_BASE_URL=http://localhost/public_html

# Enable only behind a reverse proxy and list every trusted proxy IP/CIDR.
APP_TRUST_PROXY_HEADERS=false
APP_TRUSTED_PROXY_IPS=

# Must be writable by PHP. Empty uses an isolated system-temp directory.
APP_RATE_LIMIT_DIR=

# Required only when cron/cleanup.php is exposed outside CLI.
CRON_SECRET=
